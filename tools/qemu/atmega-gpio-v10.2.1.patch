diff --git a/hw/gpio/atmega_gpio.c b/hw/gpio/atmega_gpio.c
new file mode 100644
index 0000000..ac71cd1
--- /dev/null
+++ b/hw/gpio/atmega_gpio.c
@@ -0,0 +1,179 @@
+/*
+ * ATmega GPIO port model.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/gpio/atmega_gpio.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define ATMEGA_GPIO_PIN  0
+#define ATMEGA_GPIO_DDR  1
+#define ATMEGA_GPIO_PORT 2
+
+static uint8_t atmega_gpio_pin_value(AtmegaGpioState *s)
+{
+    return (s->port & s->ddr) | (s->external_level & ~s->ddr);
+}
+
+static void atmega_gpio_update_outputs(AtmegaGpioState *s)
+{
+    uint8_t value = s->port & s->ddr;
+    uint8_t changed = s->last_output ^ value;
+
+    while (changed) {
+        int bit = ctz32(changed);
+        qemu_set_irq(s->out[bit], (value >> bit) & 1);
+        changed &= ~(1u << bit);
+    }
+
+    s->last_output = value;
+}
+
+static uint64_t atmega_gpio_read(void *opaque, hwaddr addr, unsigned size)
+{
+    AtmegaGpioState *s = opaque;
+
+    if (size != 1) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: invalid size %u\n",
+                      __func__, size);
+        return 0;
+    }
+
+    switch (addr) {
+    case ATMEGA_GPIO_PIN:
+        return atmega_gpio_pin_value(s);
+    case ATMEGA_GPIO_DDR:
+        return s->ddr;
+    case ATMEGA_GPIO_PORT:
+        return s->port;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: bad offset 0x%" HWADDR_PRIx "\n", __func__, addr);
+        return 0;
+    }
+}
+
+static void atmega_gpio_write(void *opaque, hwaddr addr, uint64_t value,
+                              unsigned size)
+{
+    AtmegaGpioState *s = opaque;
+    uint8_t byte = value & 0xff;
+
+    if (size != 1) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: invalid size %u\n",
+                      __func__, size);
+        return;
+    }
+
+    switch (addr) {
+    case ATMEGA_GPIO_PIN:
+        /* AVR toggles PORT bits when software writes one bits to PINx. */
+        s->port ^= byte;
+        break;
+    case ATMEGA_GPIO_DDR:
+        s->ddr = byte;
+        break;
+    case ATMEGA_GPIO_PORT:
+        s->port = byte;
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: bad offset 0x%" HWADDR_PRIx "\n", __func__, addr);
+        return;
+    }
+
+    atmega_gpio_update_outputs(s);
+}
+
+static void atmega_gpio_set_external(void *opaque, int line, int level)
+{
+    AtmegaGpioState *s = opaque;
+
+    if (level) {
+        s->external_level |= 1u << line;
+    } else {
+        s->external_level &= ~(1u << line);
+    }
+}
+
+static const MemoryRegionOps atmega_gpio_ops = {
+    .read = atmega_gpio_read,
+    .write = atmega_gpio_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 1,
+    },
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 1,
+    },
+};
+
+static void atmega_gpio_init(Object *obj)
+{
+    AtmegaGpioState *s = ATMEGA_GPIO(obj);
+    DeviceState *dev = DEVICE(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    qdev_init_gpio_in(dev, atmega_gpio_set_external, 8);
+    qdev_init_gpio_out(dev, s->out, 8);
+    object_property_add_uint8_ptr(obj, "external-level",
+                                  &s->external_level,
+                                  OBJ_PROP_FLAG_READWRITE);
+    memory_region_init_io(&s->iomem, obj, &atmega_gpio_ops, s,
+                          "atmega-gpio", 3);
+    sysbus_init_mmio(sbd, &s->iomem);
+}
+
+static void atmega_gpio_reset(DeviceState *dev)
+{
+    AtmegaGpioState *s = ATMEGA_GPIO(dev);
+
+    s->ddr = 0;
+    s->port = 0;
+    s->last_output = 0;
+    atmega_gpio_update_outputs(s);
+}
+
+static const VMStateDescription vmstate_atmega_gpio = {
+    .name = "atmega-gpio",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8(ddr, AtmegaGpioState),
+        VMSTATE_UINT8(port, AtmegaGpioState),
+        VMSTATE_UINT8(external_level, AtmegaGpioState),
+        VMSTATE_UINT8(last_output, AtmegaGpioState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void atmega_gpio_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, atmega_gpio_reset);
+    dc->vmsd = &vmstate_atmega_gpio;
+}
+
+static const TypeInfo atmega_gpio_info = {
+    .name          = TYPE_ATMEGA_GPIO,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(AtmegaGpioState),
+    .instance_init = atmega_gpio_init,
+    .class_init    = atmega_gpio_class_init,
+};
+
+static void atmega_gpio_register_types(void)
+{
+    type_register_static(&atmega_gpio_info);
+}
+
+type_init(atmega_gpio_register_types)
