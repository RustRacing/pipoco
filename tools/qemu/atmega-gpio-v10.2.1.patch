diff --git a/include/hw/gpio/atmega_gpio.h b/include/hw/gpio/atmega_gpio.h
new file mode 100644
index 0000000..f88d89b
--- /dev/null
+++ b/include/hw/gpio/atmega_gpio.h
@@ -0,0 +1,29 @@
+/*
+ * ATmega GPIO port model.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_GPIO_ATMEGA_GPIO_H
+#define HW_GPIO_ATMEGA_GPIO_H
+
+#include "system/memory.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_ATMEGA_GPIO "atmega-gpio"
+OBJECT_DECLARE_SIMPLE_TYPE(AtmegaGpioState, ATMEGA_GPIO)
+
+struct AtmegaGpioState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq out[8];
+    uint8_t ddr;
+    uint8_t port;
+    uint8_t external_level;
+    uint8_t last_output;
+};
+
+#endif
