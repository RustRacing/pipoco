{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerusEvidence",
  "description": "Schema for target/formal-evidence/latest/verus.json emitted by tools/verify_formal.sh.",
  "type": "object",
  "required": [
    "tool",
    "version",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "tool": {
      "type": "string",
      "const": "verus"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "verified_count": {
      "type": "integer",
      "minimum": 0
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
